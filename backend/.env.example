# Plantilla de variables de entorno del backend (copiar a .env o al panel del hosting)
NODE_ENV=production
PORT=4001
DATABASE_URL=postgresql://usuario:clave@host/db?sslmode=require

# Firma de sesiones JWT (mínimo 32 caracteres)
JWT_SECRET=

# Propietario inicial: solo se usa si la base está vacía (primer arranque)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# URL(s) del frontend separadas por comas (CORS)
FRONTEND_URL=https://tu-frontend.vercel.app
# ALLOW_VERCEL_PREVIEWS=1   # permitir también previews *.vercel.app
# TRUST_PROXY=1             # proxies delante del backend (1 por defecto en producción)
